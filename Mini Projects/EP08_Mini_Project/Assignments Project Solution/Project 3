import 'dart:io';

// Movie Category Enum
enum MovieType { action, comedy, horror }

// Simple input function
String input(String msg) {
  stdout.write(msg);
  return stdin.readLineSync() ?? "";
}

void main() {
  print("\n========== MOVIE TICKET BOOKING ==========\n");

  // -----------------------------------------
  // STEP 1: Choose Movie Category
  // -----------------------------------------
  print("Choose Movie Category:");
  print("1. Action");
  print("2. Comedy");
  print("3. Horror");

  String option = input("Enter option (1-3): ");

  MovieType movie;

  if (option == "1") {
    movie = MovieType.action;
  } else if (option == "2") {
    movie = MovieType.comedy;
  } else {
    movie = MovieType.horror;
  }

  // -----------------------------------------
  // STEP 2: Set Base Price Using Switch Case
  // -----------------------------------------
  double price = 0;

  switch (movie) {
    case MovieType.action:
      price = 200;
      break;
    case MovieType.comedy:
      price = 150;
      break;
    case MovieType.horror:
      price = 180;
      break;
  }

  // -----------------------------------------
  // STEP 3: Weekend Extra Charge (Nested IF)
  // -----------------------------------------
  String day = input("Is today weekend? (yes/no): ").toLowerCase();

  if (day == "yes") {
    price += 50; // add weekend charge
  }

  // -----------------------------------------
  // STEP 4: Ternary → Child discount
  // -----------------------------------------
  String child = input("Is it a child ticket? (yes/no): ").toLowerCase();

  // If child → 20% discount
  price = child == "yes" ? (price * 0.8) : price;

  // -----------------------------------------
  // STEP 5: Print Final Ticket
  // -----------------------------------------
  print("\n========= TICKET SUMMARY =========");
  print("Movie Category : $movie");
  print("Final Ticket Price : ₹$price");
  print("===================================\n");
}
